# =====================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to `.env` on the production server.
# NEVER commit real credentials.
# =====================================================

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=8000
NODE_ENV=production

# =====================================================
# DATABASE CONFIGURATION
# Either use DATABASE_URL (recommended for cloud providers)
# or the individual DB_* variables below.
# =====================================================
# DATABASE_URL=postgres://user:password@db-host:5432/dbname
# DB_SSL=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=Water_Point_Monitoring_System
DB_USER=postgres
DB_PASSWORD=

# =====================================================
# JWT AUTHENTICATION
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =====================================================
JWT_SECRET=
JWT_EXPIRE=30d

# =====================================================
# GOOGLE MAPS API
# Restrict the key to your domain (HTTP referrer) in Google Cloud Console.
# Set this to the API key used at build time (REACT_APP_GOOGLE_MAPS_API_KEY).
# =====================================================
GOOGLE_MAPS_API_KEY=

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# =====================================================
# APPLICATION SETTINGS
# APP_URL must match the public domain, e.g. https://water.sodo.gov.et
# =====================================================
APP_NAME=Wolaita Sodo Water-Point Monitoring System
APP_URL=https://your-domain.example

# =====================================================
# OPTIONAL: SMS NOTIFICATIONS (Africa's Talking)
# =====================================================
SMS_API_KEY=
SMS_USERNAME=

# =====================================================
# OPTIONAL: EMAIL NOTIFICATIONS
# =====================================================
EMAIL_SERVICE=
EMAIL_API_KEY=
EMAIL_FROM=noreply@sodowater.gov.et

# =====================================================
# PRODUCTION CHECKLIST
# 1. Set NODE_ENV=production
# 2. Point to a production database (or DATABASE_URL)
# 3. Generate a NEW strong JWT_SECRET (never reuse the dev one)
# 4. Set APP_URL to your HTTPS domain
# 5. Terminate SSL/TLS at your reverse proxy (Nginx/Caddy) or load balancer
# 6. Build the frontend:  npm run build
# 7. Run with PM2 (pm2 start ecosystem.config.js) or Docker
# 8. Change the default admin password after first login
# 9. Schedule regular DB backups:  npm run db:backup
# =====================================================