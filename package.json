{
  "name": "wolaita-sodo-water-monitoring",
  "version": "1.0.0",
  "description": "Community Water-Point Monitoring System for Wolaita Zone, South Ethiopia",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "client": "cd client && npm start",
    "install-all": "npm install && cd client && npm install",
    "build": "npm --prefix client run build",
    "start:prod": "node server/server.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js"
  },
  "keywords": ["water", "monitoring", "community", "ethiopia", "wash", "wolaita", "sodo"],
  "author": "Tesfa - Sunshine Tech Solution",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "xss-clean": "^0.1.4",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
